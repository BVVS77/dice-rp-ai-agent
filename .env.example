# Ollama uses the local server and needs no API key.
DICERP_AI_PROVIDER=ollama
DICERP_CHAT_MODEL=qwen3:8b
DICERP_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
DICERP_STATE_DIR=.dicerp

# Optional per-request timeout for local model loading and inference.
# DICERP_OLLAMA_TIMEOUT_SECONDS=60

# For OpenAI, set DICERP_AI_PROVIDER=openai and change the two model settings
# to gpt-4.1-mini and text-embedding-3-small or remove them to use those defaults.
# OPENAI_API_KEY=
